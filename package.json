{
  "name": "wake",
  "version": "0.1.0",
  "description": "Session tracing and context routing for AI agents that browse your website.",
  "type": "module",
  "bin": {
    "wake": "bin/wake.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./node": "./src/node.js",
    "./node-middleware": "./adapters/node.js",
    "./next": "./adapters/next.js",
    "./worker": "./adapters/worker.js",
    "./collector": "./src/collector.js",
    "./storage": "./src/store.js",
    "./ee": "./ee/index.js",
    "./ee/collector-worker": "./ee/collector-worker.js"
  },
  "scripts": {
    "test": "node --no-warnings --test test/*.test.js ee/test/*.test.js",
    "example:site": "node --no-warnings examples/meridian/site-server.js",
    "start": "node --no-warnings bin/wake.js --config examples/meridian/wake.config.js",
    "simulate": "node --no-warnings scripts/simulate.js",
    "test:pg": "WAKE_TEST_PG=${WAKE_TEST_PG:-postgres://postgres@127.0.0.1:5432/postgres} node --no-warnings --test test/*.test.js ee/test/*.test.js",
    "collector:dev": "cd ee/deploy/cloudflare && wrangler dev",
    "collector:deploy": "cd ee/deploy/cloudflare && wrangler deploy"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "SEE LICENSE IN NOTICE",
  "devDependencies": {
    "pg": "^8.23.1",
    "wrangler": "^4.151.1"
  },
  "peerDependencies": {
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xhoantran/wake.git"
  },
  "files": [
    "src",
    "adapters",
    "bin",
    "ee",
    "examples",
    "LICENSE",
    "NOTICE",
    "README.md"
  ]
}
